# 应用配置
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_ENV=development

# 数据库配置
DATABASE__HOST=localhost
DATABASE__PORT=3306
DATABASE__USERNAME=root
DATABASE__PASSWORD=your_password
DATABASE__DATABASE=ad_data
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10
DATABASE__POOL_TIMEOUT=30

# HTTP客户端配置
HTTP__TIMEOUT=30
HTTP__MAX_CONNECTIONS=100
HTTP__RETRY_TIMES=3
HTTP__RETRY_DELAY=1.0

# Redis配置
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0

# 百度平台配置
PLATFORMS__BAIDU__NAME=baidu
PLATFORMS__BAIDU__API_KEY=your_baidu_api_key
PLATFORMS__BAIDU__SECRET_KEY=your_baidu_secret_key
PLATFORMS__BAIDU__BASE_URL=https://api.baidu.com
PLATFORMS__BAIDU__RATE_LIMIT=100

# 搜狗平台配置
PLATFORMS__SOGOU__NAME=sogou
PLATFORMS__SOGOU__API_KEY=your_sogou_api_key
PLATFORMS__SOGOU__SECRET_KEY=your_sogou_secret_key
PLATFORMS__SOGOU__BASE_URL=https://api.sogou.com
PLATFORMS__SOGOU__RATE_LIMIT=100

# 360平台配置
PLATFORMS__QIHOO360__NAME=qihoo360
PLATFORMS__QIHOO360__API_KEY=your_360_api_key
PLATFORMS__QIHOO360__SECRET_KEY=your_360_secret_key
PLATFORMS__QIHOO360__BASE_URL=https://api.360.cn
PLATFORMS__QIHOO360__RATE_LIMIT=100

# 神马平台配置
PLATFORMS__SHENMA__NAME=shenma
PLATFORMS__SHENMA__API_KEY=your_shenma_api_key
PLATFORMS__SHENMA__SECRET_KEY=your_shenma_secret_key
PLATFORMS__SHENMA__BASE_URL=https://api.sm.cn
PLATFORMS__SHENMA__RATE_LIMIT=100

# 字节跳动平台配置
PLATFORMS__BYTEDANCE__NAME=bytedance
PLATFORMS__BYTEDANCE__API_KEY=your_bytedance_api_key
PLATFORMS__BYTEDANCE__SECRET_KEY=your_bytedance_secret_key
PLATFORMS__BYTEDANCE__BASE_URL=https://api.oceanengine.com
PLATFORMS__BYTEDANCE__RATE_LIMIT=100

# 腾讯平台配置
PLATFORMS__TENCENT__NAME=tencent
PLATFORMS__TENCENT__API_KEY=your_tencent_api_key
PLATFORMS__TENCENT__SECRET_KEY=your_tencent_secret_key
PLATFORMS__TENCENT__BASE_URL=https://api.e.qq.com
PLATFORMS__TENCENT__RATE_LIMIT=100

# 监控配置
MONITOR__ENABLE=true
MONITOR__INTERVAL=60
MONITOR__ALERT_THRESHOLD=90

# 日志配置
LOG__LEVEL=INFO
LOG__FORMAT=json
LOG__FILE_PATH=./logs/app.log
LOG__MAX_SIZE=100MB
LOG__BACKUP_COUNT=7